    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "scripts/verify.mjs"
  ],
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  }
